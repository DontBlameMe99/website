{
	"files": {
		"includes": ["app/**"]
	},
	"formatter": {
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 80
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"trailingCommas": "all"
		}
	},
	"linter": {
		"rules": {
			"correctness": {
				"useExhaustiveDependencies": "warn"
			}
		}
	},
	"overrides": [
		{
			"includes": ["app/content/experiences/**/*.tsx"],
			"linter": {
				"rules": {
					"a11y": {
						"useSemanticElements": "off",
						"useAriaPropsSupportedByRole": "off"
					}
				}
			}
		},
		{
			"includes": ["app/app.css"],
			"linter": {
				"rules": {
					"complexity": {
						"noImportantStyles": "off"
					}
				}
			}
		},
		{
			"includes": ["app/content/posts/**/*.tsx"],
			"linter": {
				"rules": {
					"a11y": {
						"noAmbiguousAnchorText": "off"
					}
				}
			}
		},
		{
			"includes": [
				"app/content/posts/backups_you_only_want_them_once_you_need_them.tsx",
				"app/content/posts/is_nixos_the_perfect_linux_distribution_for_you.tsx",
				"app/content/posts/replacing_obsidian_with_neovim_and_typst.tsx"
			],
			"linter": {
				"rules": {
					"a11y": {
						"noNoninteractiveTabindex": "off"
					}
				}
			}
		}
	]
}
