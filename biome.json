{
	"files": {
		"includes": ["app/**", "scripts/**"]
	},
	"formatter": {
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 80
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"trailingCommas": "all"
		}
	},
	"linter": {
		"rules": {
			"correctness": {
				"useExhaustiveDependencies": "warn"
			}
		}
	},
	"overrides": [
		{
			"includes": ["app/content/experiences/**/*.tsx"],
			"linter": {
				"rules": {
					"a11y": {
						"useSemanticElements": "off",
						"useAriaPropsSupportedByRole": "off"
					}
				}
			}
		},
		{
			"includes": ["app/app.css", "app/styles/**/*.css"],
			"linter": {
				"rules": {
					"complexity": {
						"noImportantStyles": "off"
					}
				}
			}
		},
		{
			"includes": ["app/content/posts/**/*.tsx"],
			"linter": {
				"rules": {
					"a11y": {
						"noAmbiguousAnchorText": "off"
					}
				}
			}
		}
	]
}
