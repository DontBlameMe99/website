{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": null,
	"bunVersion": "1.4.x",
	"installCommand": "bun install --frozen-lockfile",
	"buildCommand": "bun run build",
	"outputDirectory": "build/client",
	"routes": [
		{ "handle": "filesystem" },
		{ "src": "/(.*)", "status": 404, "dest": "/404/index.html" }
	]
}
